{
  "name": "ble-id-exchange",
  "private": true,
  "version": "0.1.0",
  "description": "BLE metadata ID exchange: web client (server-relay), native wrapper (BLE listen + advertise), Fastify SQLite relay",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:server": "turbo run dev --filter=bleak-node",
    "dev:web": "turbo run dev --filter=bleak-web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "packageManager": "npm@11.12.1"
}
