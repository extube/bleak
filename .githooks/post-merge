#!/bin/sh
# Enforce "squash-only merges into dev (except syncing FROM main)".
# pre-merge-commit cannot see MERGE_HEAD for clean auto-merges (git writes it
# after the hook), so this hook unwinds illegal merge states after the fact
# (ORIG_HEAD still points at pre-merge dev).
branch=$(git symbolic-ref --quiet --short HEAD || true)
[ "$branch" = "dev" ] || exit 0

head=$(git rev-parse HEAD)
orig=$(git rev-parse ORIG_HEAD 2>/dev/null) || exit 0
p2=$(git rev-parse "HEAD^2" 2>/dev/null) || true

if [ -n "$p2" ]; then
  # Real (non-FF) merge commit.
  main_local=$(git rev-parse refs/heads/main 2>/dev/null)
  main_remote=$(git rev-parse refs/remotes/origin/main 2>/dev/null)
  if [ "$p2" != "$main_local" ] && [ "$p2" != "$main_remote" ]; then
    echo >&2 "BLOCKED: merge commits into 'dev' are only allowed when syncing from 'main'."
    echo >&2 "        Unwinding this merge; land the branch with:"
    echo >&2 "        git merge --squash <branch>  (then commit with a feat|fix: [#n] message)"
    git reset --hard "$orig" >/dev/null 2>&1
    echo >&2 "        dev was rewound to: $(git rev-parse --short "$orig")"
    exit 1
  fi
  exit 0
fi

# Single parent on dev after a merge: this was a fast-forward.
if [ "$head" != "$orig" ] && git merge-base --is-ancestor "$orig" "$head" 2>/dev/null; then
  remote_dev=$(git rev-parse refs/remotes/origin/dev 2>/dev/null)
  if [ "$head" != "$remote_dev" ]; then
    echo >&2 "BLOCKED: fast-forward merges into 'dev' are forbidden (no squash point)."
    echo >&2 "        Unwinding; land the branch with:  git merge --squash <branch>"
    git reset --hard "$orig" >/dev/null 2>&1
    echo >&2 "        dev was rewound to: $(git rev-parse --short "$orig")"
    exit 1
  fi
fi

exit 0
